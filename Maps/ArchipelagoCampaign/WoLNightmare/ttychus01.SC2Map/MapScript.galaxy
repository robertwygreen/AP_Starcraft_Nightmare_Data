            return false;
        }

        if (!((gv_dragoonSpawnComplete == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(1.0, c_timeGame);
    for (auto6048F4ED_i = 1; auto6048F4ED_i <= auto6048F4ED_n; auto6048F4ED_i += 1) {
        Wait(0.25, c_timeGame);
    }
    Wait(7.0, c_timeGame);
    libNtve_gf_RescueUnit2(UnitGroup("AP_Dragoon", 8, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), 1, true);
