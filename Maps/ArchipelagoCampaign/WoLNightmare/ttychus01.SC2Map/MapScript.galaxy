void gt_VictoryCinematic2_Init () {
    gt_VictoryCinematic2 = TriggerCreate("gt_VictoryCinematic2_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Victory Cinematic End 2
//--------------------------------------------------------------------------------------------------
bool gt_VictoryCinematicEnd2_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_fadeDuration;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_victoryCinematicCompleted2 == true)) {
        lv_fadeDuration = 3.0;
    }
    else {
        lv_fadeDuration = 0.5;
    }
    CinematicFade(false, lv_fadeDuration, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, false);
    Wait(lv_fadeDuration, c_timeReal);
    UnitPauseAll(true);
    GameOver(1, c_gameOverVictory, false, false);
    return true;
}

