        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerQueueEnter();
    TriggerExecute(gt_ObjectiveGettotheArtifactCreate2, true, false);
    Wait(libCamp_gv_campaignObjectiveDelay, c_timeReal);
    auto02956131_g = UnitGroup("StoneZealot", 0, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    auto02956131_u = UnitGroupCount(auto02956131_g, c_unitCountAll);
    for (;; auto02956131_u -= 1) {
        auto02956131_var = UnitGroupUnitFromEnd(auto02956131_g, auto02956131_u);
