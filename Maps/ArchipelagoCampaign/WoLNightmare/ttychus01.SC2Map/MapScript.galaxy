//--------------------------------------------------------------------------------------------------
// Trigger: MasteryKerriganBaseDestroyed
//--------------------------------------------------------------------------------------------------
bool gt_MasteryKerriganBaseDestroyed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((gv_inCinematic2 == false))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), gv_p2_ZERG2, UnitFilter((1 << c_targetFilterStructure), 0, 0, 0)) == true))) {
            return false;
        }

        if (!(((UnitCount(null, gv_p2_ZERG2, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventReveal), 0, 0, 0), 0) == 0) || ((UnitCount(null, gv_p2_ZERG2, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventReveal), 0, 0, 0), 0) <= 1) && (UnitFilterMatch(EventUnit(), gv_p2_ZERG2, UnitFilter((1 << c_targetFilterPreventReveal), 0, 0, 0)) == true))))) {
            return false;
        }

        if (!((UnitCount(null, gv_p2_ZERG2, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0, 0), 0) <= 3))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerExecute(gt_MasteryObjectiveDestroyKerriganBaseCreate, true, false);
    return true;
}

