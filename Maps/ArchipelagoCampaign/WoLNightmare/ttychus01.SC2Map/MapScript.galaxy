//--------------------------------------------------------------------------------------------------
// Trigger: Zerg Attack Waves - Protoss 2
//--------------------------------------------------------------------------------------------------
bool gt_ZergAttackWavesProtoss2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_zergSpeedBumpTimer2, libNtve_gf_DifficultyValueFixed(2700.0, 1800.0, 1440.0, 1260.0), false, c_timeAI);
    TimerStart(gv_zergSpeedBumpTimerShorter2, (TimerGetRemaining(gv_zergSpeedBumpTimer2) - 60.0), false, c_timeAI);
    TriggerExecute(gt_ZergSpeedBumpController2, true, false);
    gf_ZergAttackProtossPrep2();
    AIAttackWaveAddUnits4(12, 12, 12, 12, "Zergling");
    AIAttackWaveSend(gv_p2_ZERG2, 30, true);
    AIAttackWaveAddUnits4(32, 32, 32, 32, "Zergling");
    AIAttackWaveAddUnits4(5, 5, 5, 5, "Hydralisk");
    AIAttackWaveSend(gv_p2_ZERG2, 30, true);
    while (true) {
        gf_ZergAttackProtossLateDelay2();
        gf_ZergAttackProtossPrep2();
        AIAttackWaveAddUnits4(3, 4, 5, 4, "Hydralisk");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Mutalisk");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(gv_p2_ZERG2, 30, true);
        gf_ZergAttackProtossLateDelay2();
        gf_ZergAttackProtossPrep2();
        AIAttackWaveAddUnits4(20, 24, 28, 32, "Zergling");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(gv_p2_ZERG2, 30, true);
        gf_ZergAttackProtossLateDelay2();
        gf_ZergAttackProtossPrep2();
        AIAttackWaveAddUnits4(4, 8, 12, 8, "Zergling");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Mutalisk");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(gv_p2_ZERG2, 30, true);
    }
    return true;
}

