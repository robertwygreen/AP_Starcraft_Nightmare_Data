    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(gv_p5_UPPER_CAUSEWAY2, PlayerGroupSingle(gv_p2_ZERG2));
    while (true) {
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(248), false);
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(246), false);
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(230), false);
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(1907), false);
        AIAttackWaveAddUnits4(4, 4, 4, 4, "Zealot");
        AIAttackWaveSend(gv_p5_UPPER_CAUSEWAY2, 45, true);
        if ((UnitGroupCount(UnitGroup(null, gv_p2_ZERG2, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterBuried), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0) && (gv_inCinematic2 == false)) {
            break;
        }

        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(248), false);
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(246), false);
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(230), false);
        AIAttackWaveAddWaypoint(gv_p5_UPPER_CAUSEWAY2, PointFromId(1907), false);
        AIAttackWaveAddUnits4(4, 4, 4, 4, "Stalker");
        AIAttackWaveSend(gv_p5_UPPER_CAUSEWAY2, 45, true);
        if ((UnitGroupCount(UnitGroup(null, gv_p2_ZERG2, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterBuried), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0) && (gv_inCinematic2 == false)) {
            break;
        }

    }
    AIAttackWaveSetTargetPlayer(gv_p5_UPPER_CAUSEWAY2, PlayerGroupSingle(gv_p1_USER2));
    while (true) {
