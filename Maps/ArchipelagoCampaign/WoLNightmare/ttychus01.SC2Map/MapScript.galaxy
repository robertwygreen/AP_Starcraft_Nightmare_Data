//--------------------------------------------------------------------------------------------------
bool gt_Victory2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((ObjectiveGetState(gv_objective_DestroytheStatues2) == c_objectiveStateCompleted) && (ObjectiveGetState(gv_objective_Relics2) == c_objectiveStateCompleted) && (ObjectiveGetState(gv_objective_GetToTheArtifact2) == c_objectiveStateCompleted)) {
        AchievementAward(gv_p1_USER2, "TTychus01_1");
    }

    if ((libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1) && (gv_statStoneGuardianKillCount2 == 0)) {
        AchievementAward(gv_p1_USER2, "TTychus01_2");
    }

    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1) && (TimerGetRemaining(gv_achievementHardTimer2) != 0.0)) {
        AchievementAward(gv_p1_USER2, "TTychus01_3");
    }

    VictoryPanelAddAchievement("TTychus01_1");
    VictoryPanelAddAchievement("TTychus01_2");
    VictoryPanelAddAchievement("TTychus01_3");
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/4F65A0F8"), IntToText(gv_statProtossKilledByPlayer2));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/2B4C0F29"), IntToText(gv_statZergKilledByPlayer2));
    VictoryPanelAddTrackedStatistic("UnitsTotalCount");
    VictoryPanelAddTrackedStatistic("UnitsLostCount");
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/4A6AD5A3"), IntToText(gv_statStoneGuardianKillCount2));
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/239D03A4"), (IntToText(gv_relicsFound2) + StringExternal("Param/Value/FDBA0032") + IntToText(gv_relicsNeeded2)));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/E551DC6A"), IntToText(gv_relicsFound2));
    GameOver(gv_p1_USER2, c_gameOverVictory, false, false);
    return true;
}

