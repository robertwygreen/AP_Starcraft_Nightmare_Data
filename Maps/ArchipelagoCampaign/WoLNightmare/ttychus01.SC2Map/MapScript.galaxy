//--------------------------------------------------------------------------------------------------
// Trigger: Creep Expansion 2
//--------------------------------------------------------------------------------------------------
bool gt_CreepExpansion2_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;
    unitgroup lv_dropPodGroup;
    point lv_dropSpot;

    // Automatic Variable Declarations
    int auto80B315B5_ae;
    const int auto80B315B5_ai = 1;

    // Variable Initialization
    lv_dropPodGroup = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        auto80B315B5_ae = gv_creepRegionsSize2;
        lv_i = 1;
        for ( ; ( (auto80B315B5_ai >= 0 && lv_i <= auto80B315B5_ae) || (auto80B315B5_ai < 0 && lv_i >= auto80B315B5_ae) ) ; lv_i += auto80B315B5_ai ) {
            Wait(9.0, c_timeGame);
            while (!((gv_inCinematic2 == false))) {
                Wait(1.0, c_timeGame);
            }
            if ((gv_gameOver2 == true)) {
                return true;
            }

            if ((UnitGroupCount(UnitGroup(null, gv_p5_UPPER_CAUSEWAY2, gv_creepRegions2[lv_i], UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
                if ((UnitGroupCount(UnitGroup("CreepTumorBurrowed", gv_p2_ZERG2, RegionCircle(RegionGetCenter(gv_creepRegions2[lv_i]), 4.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
                    libCamp_gf_CreateDropPod(libCamp_ge_DropPodRace_Zerg, RegionGetCenter(gv_creepRegions2[lv_i]), UnitGroupEmpty(), true);
                }
                else {
                    if ((UnitGroupCount(UnitGroup(null, gv_p2_ZERG2, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 250)) {
                        lv_dropPodGroup = UnitLastCreatedGroup();
                        UnitGroupAdd(lv_dropPodGroup, UnitLastCreated());
                        AISetGroupScriptControlled(lv_dropPodGroup, true);
                        lv_dropSpot = RegionRandomPoint(RegionCircle(RegionGetCenter(gv_creepRegions2[lv_i]), 2.0));
                        libCamp_gf_CreateDropPod(libCamp_ge_DropPodRace_Zerg, lv_dropSpot, lv_dropPodGroup, true);
                        AISetGroupScriptControlled(lv_dropPodGroup, false);
                        AIAttackWaveSetTargetPoint(gv_p2_ZERG2, PointFromId(724));
                        AIAttackWaveSetGatherPoint(gv_p2_ZERG2, lv_dropSpot);
                        if ((PointGetX(lv_dropSpot) < PointGetX(PointFromId(246)))) {
                            AIAttackWaveAddWaypoint(gv_p2_ZERG2, PointFromId(246), false);
                        }

                        if ((PointGetX(lv_dropSpot) < PointGetX(PointFromId(248)))) {
                            AIAttackWaveAddWaypoint(gv_p2_ZERG2, PointFromId(248), false);
                        }

                        AIAttackWaveAddWaypoint(gv_p2_ZERG2, PointFromId(250), false);
                        AIAttackWaveUseGroup(gv_p2_ZERG2, lv_dropPodGroup);
                        AIAttackWaveSend(gv_p2_ZERG2, 0, false);
                    }

                }
            }

        }
    }
    return true;
}

