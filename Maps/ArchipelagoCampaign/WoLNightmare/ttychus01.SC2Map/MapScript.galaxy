    gt_ObjectiveRelicsUpdate2 = TriggerCreate("gt_ObjectiveRelicsUpdate2_Func");
    TriggerAddEventUnitAbility(gt_ObjectiveRelicsUpdate2, null, AbilityCommand("Pickup", 0), c_unitAbilStageExecute, false);
}

