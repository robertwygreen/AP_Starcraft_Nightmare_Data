//--------------------------------------------------------------------------------------------------
bool gt_VictoryQ2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_gameOver2 = true;
    TriggerStop(gt_CreepExpansion2);
    TriggerStop(gt_ZergAttackWavesPlayer2);
    TriggerStop(gt_ZergAttackWavesProtoss2);
    TriggerStop(gt_UpperProtossAttackWaves2);
    TriggerQueueEnter();
    TriggerExecute(gt_VictorySetup2, true, true);
    TriggerExecute(gt_VictoryCinematic2, true, true);
    TriggerExecute(gt_VictoryCinematicEnd2, true, true);
    TriggerExecute(gt_VictoryCleanup2, true, true);
    TriggerQueueExit();
    return true;
}

