//--------------------------------------------------------------------------------------------------
// Trigger: Objective - Relics - Discover 2
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveRelicsDiscover2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver2 == false))) {
            return false;
        }

        if (!((gv_inCinematic2 == false))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == gv_p1_USER2))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), gv_p1_USER2, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerExecute(gt_RelicTipQ2, true, false);
    UnitFlashSelection(UnitFromId(430), 1.0);
    libNtve_gf_CreateModelAtPoint("BriefingUnitSelect", libNtve_gf_PointWithZOffset(UnitGetPosition(UnitFromId(430)), 0.7));
    ActorSend(libNtve_gf_ActorLastCreated(), "SetScale 0.800000");
    gv_relicPingActor2 = libNtve_gf_ActorLastCreated();
    Wait(0.5, c_timeReal);
    TriggerExecute(gt_ObjectiveRelicsCreateQ2, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ObjectiveRelicsDiscover2_Init () {
    gt_ObjectiveRelicsDiscover2 = TriggerCreate("gt_ObjectiveRelicsDiscover2_Func");
    TriggerAddEventUnitRegion(gt_ObjectiveRelicsDiscover2, null, RegionFromId(70), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Objective - Relics - Update 2
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveRelicsUpdate2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "ProtossRelic"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_KillModel(gv_relicPingActor2);
    libCamp_gf_DisplayResearchPointsGiventoPlayer(libCamp_ge_StoryResearchObject_ResearchObjectFindProtossRelics, EventUnit(), gv_p1_USER2);
    TriggerExecute(gt_ObjectiveRelicsCreateQ2, true, false);
    UnitKill(EventUnit());
    gv_relicsFound2 += 1;
    if ((gv_relicsFound2 == gv_relicsNeeded2)) {
        TriggerExecute(gt_ObjectiveRelicsComplete2, true, false);
    }

    if ((gv_relicsFound2 == gv_relicsNeeded2) && (libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1) && (gv_zergStructuresKilled2 == false)) {
        AchievementAward(gv_p1_USER2, "Anniversary_TTychus01");
        TriggerDebugOutput(1, StringExternal("Param/Value/400840CE"), false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
