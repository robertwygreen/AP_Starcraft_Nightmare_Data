        UnitSetState(auto02956131_var, c_unitStateHidden, false);
    }
    VisRevealArea(gv_p1_USER2, RegionCircle(UnitGetPosition(gv_artifact2), 16.0), 10.0, false);
    VisRevealerCreate(gv_p1_USER2, RegionCircle(UnitGetPosition(gv_artifact2), 8.0));
    ObjectiveSetState(gv_objective_GetToTheArtifact2, c_objectiveStateActive);
    libNtve_gf_CreatePingFacingAngle(PlayerGroupSingle(gv_p1_USER2), "PingObjective", UnitGetPosition(gv_artifact2), Color(0.00, 100.00, 0.00), 0.0, 270.0);
    gv_artifactObjectivePing2 = PingLastCreated();
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/6B98F40D"));
    TriggerQueueExit();
    return true;
