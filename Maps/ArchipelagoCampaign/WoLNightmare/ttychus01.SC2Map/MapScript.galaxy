    gt_ZergSpeedBumpTimerExpires = TriggerCreate("gt_ZergSpeedBumpTimerExpires_Func");
    TriggerAddEventTimer(gt_ZergSpeedBumpTimerExpires, gv_zergSpeedBumpTimer);
