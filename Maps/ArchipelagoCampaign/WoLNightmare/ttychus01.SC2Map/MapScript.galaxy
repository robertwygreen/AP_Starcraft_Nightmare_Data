    gt_ObjectiveRelicsUpdate = TriggerCreate("gt_ObjectiveRelicsUpdate_Func");
    TriggerAddEventUnitAbility(gt_ObjectiveRelicsUpdate, null, AbilityCommand("Pickup", 0), c_unitAbilStageExecute, false);
}

