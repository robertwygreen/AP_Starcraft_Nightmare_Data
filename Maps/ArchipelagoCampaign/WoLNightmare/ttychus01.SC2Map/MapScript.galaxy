//--------------------------------------------------------------------------------------------------
bool gt_DragoonWarpIn_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int auto6048F4ED_n = 3;
    int auto6048F4ED_i;

    // Conditions
    if (testConds) {
